<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. All screens are drawn with Jetpack Compose + Material 3. -->
    <style name="Theme.SalonManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Branded splash screen (AndroidX SplashScreen works back to Android 8). -->
    <style name="Theme.SalonManager.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SalonManager</item>
    </style>
</resources>
