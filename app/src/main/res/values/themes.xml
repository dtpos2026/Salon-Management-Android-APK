<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. All screens are drawn with Jetpack Compose + Material 3. -->
    <style name="Theme.SalonManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash (AndroidX SplashScreen works back to Android 8). It hands over to the
         animated intro drawn in Compose on the same purple, so the transition is seamless. -->
    <style name="Theme.SalonManager.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_purple</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SalonManager</item>
    </style>
</resources>
