<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Automatic cloud / device-transfer backup is disabled because the
    database may contain a licence and security hashes; use the in-app Backup & Restore instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
