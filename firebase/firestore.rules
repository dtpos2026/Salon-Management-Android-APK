rules_version = '2';

// DT Salon Management - Firestore security rules.
// Only accounts, licences, invoices, app settings, support chat and daily sales totals
// (numbers only) live online. Salon records (receipts, customers, staff, expenses) never
// leave the phone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Super admins are documents in /admins/{uid}. The first one is created by hand in the
    // Firebase console (see docs/SETUP_GUIDE.md); after that admins can add others.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function text(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalText(data, key, max) {
      return !(key in data) || data[key] == null || text(data[key], max);
    }

    // Random id the app gives each phone install; the account is approved for one phone.
    function deviceIdOk(value) {
      return value is string && value.size() >= 8 && value.size() <= 128;
    }

    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Bootstrap: the very first admin claims the panel in one batch with config/owner.
      // Once config/owner exists, only admins can add admins.
      allow create: if isAdmin() || (isSelf(uid)
        && !exists(/databases/$(database)/documents/config/owner)
        && getAfter(/databases/$(database)/documents/config/owner).data.uid == uid);
      allow update, delete: if isAdmin();
    }

    // Salon accounts (email + password sign-in). A salon owner can only create their own account
    // in PENDING state, bound to the phone it registered from, and later update harmless fields. Status, IDs, plan, expiry and billing are admin-only.
    match /accounts/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'salonName', 'ownerName', 'phone', 'city',
          'address', 'salonNameLower', 'ownerNameLower', 'phoneDigits', 'status', 'platform',
          'appVersion', 'deviceId', 'deviceModel', 'createdAt', 'lastSeenAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.email == request.auth.token.email
        && text(request.resource.data.salonName, 120) && request.resource.data.salonName.size() > 0
        && text(request.resource.data.ownerName, 120)
        && text(request.resource.data.phone, 40)
        && optionalText(request.resource.data, 'city', 80)
        && optionalText(request.resource.data, 'address', 300)
        && deviceIdOk(request.resource.data.deviceId)
        && request.resource.data.createdAt == request.time;

      // The owner may refresh harmless fields and ask for a new phone to be approved
      // (pendingDevice*). Only an admin approves phones (deviceIds, maxDevices).
      allow update: if isAdmin() || (isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastSeenAt', 'appVersion', 'deviceModel', 'displayName', 'photoUrl',
                       'pendingDeviceId', 'pendingDeviceModel', 'pendingDeviceAt'])
        && request.resource.data.lastSeenAt == request.time
        && optionalText(request.resource.data, 'deviceModel', 120)
        && optionalText(request.resource.data, 'pendingDeviceModel', 120)
        && (!('pendingDeviceId' in request.resource.data.diff(resource.data).affectedKeys())
            || (deviceIdOk(request.resource.data.pendingDeviceId)
                && request.resource.data.pendingDeviceAt == request.time)));

      allow delete: if isAdmin();
    }

    // Support chat between a salon and the Super Admin (and the AI helper, which writes with
    // admin rights from a Cloud Function). One thread per salon account.
    match /support/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'salonName', 'email', 'lastMessage', 'lastFrom', 'lastAt', 'unreadForAdmin', 'unreadForUser', 'lang'])
        && request.resource.data.uid == uid
        && request.resource.data.lastFrom == 'user'
        && request.resource.data.lastAt == request.time
        && text(request.resource.data.lastMessage, 200)
        && optionalText(request.resource.data, 'salonName', 120)
        && optionalText(request.resource.data, 'lang', 10));
      allow delete: if isAdmin();

      match /messages/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || (isSelf(uid)
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == 'user'
          && text(request.resource.data.text, 2000) && request.resource.data.text.size() > 0
          && request.resource.data.at == request.time);
        // "Clear old chat": a salon may delete its own thread's messages; editing stays admin-only.
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if isAdmin();
      }
    }

    // Daily sales totals a salon shares with the Super Admin, who bills by sales. Numbers only:
    // no customer names, phones or receipts. The salon writes its own; admins read.
    function amount(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 0 && data[key] <= 100000000000000);
    }

    match /stats/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'salonName', 'currency', 'day', 'todaySalesMinor', 'todayCustomers',
          'yesterdaySalesMinor', 'yesterdayCustomers', 'monthKey', 'monthSalesMinor',
          'monthCustomers', 'appVersion', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time
        && optionalText(request.resource.data, 'salonName', 120)
        && optionalText(request.resource.data, 'currency', 10)
        && optionalText(request.resource.data, 'day', 10)
        && optionalText(request.resource.data, 'monthKey', 7)
        && optionalText(request.resource.data, 'appVersion', 40)
        && amount(request.resource.data, 'todaySalesMinor')
        && amount(request.resource.data, 'todayCustomers')
        && amount(request.resource.data, 'yesterdaySalesMinor')
        && amount(request.resource.data, 'yesterdayCustomers')
        && amount(request.resource.data, 'monthSalesMinor')
        && amount(request.resource.data, 'monthCustomers');
      allow delete: if isAdmin();

      match /days/{day} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly([
            'date', 'salesMinor', 'customers', 'services', 'cashMinor', 'onlineMinor', 'creditMinor', 'updatedAt'])
          && request.resource.data.date == day
          && request.resource.data.updatedAt == request.time
          && amount(request.resource.data, 'salesMinor')
          && amount(request.resource.data, 'customers')
          && amount(request.resource.data, 'services')
          && amount(request.resource.data, 'cashMinor')
          && amount(request.resource.data, 'onlineMinor')
          && amount(request.resource.data, 'creditMinor');
        allow delete: if isAdmin();
      }
    }

    // Phone status for the Super Admin's phone list and map: model, versions, last seen and,
    // only when the owner allows it, the approximate location. No salon data.
    function coordinate(data, key, limit) {
      return !(key in data) || (data[key] is number && data[key] >= -limit && data[key] <= limit);
    }

    match /devices/{id} {
      allow get, list: if isAdmin();
      allow create, update: if signedIn()
        && id == request.auth.uid + '__' + request.resource.data.deviceId
        && request.resource.data.keys().hasOnly([
          'uid', 'deviceId', 'model', 'platform', 'osVersion', 'appVersion', 'locationPermission',
          'lastSeenAt', 'lat', 'lng', 'accuracyM', 'locationAt'])
        && request.resource.data.uid == request.auth.uid
        && deviceIdOk(request.resource.data.deviceId)
        && request.resource.data.lastSeenAt == request.time
        && optionalText(request.resource.data, 'model', 120)
        && optionalText(request.resource.data, 'platform', 20)
        && optionalText(request.resource.data, 'osVersion', 40)
        && optionalText(request.resource.data, 'appVersion', 40)
        && request.resource.data.locationPermission in ['off', 'granted', 'denied']
        && coordinate(request.resource.data, 'lat', 90)
        && coordinate(request.resource.data, 'lng', 180)
        && coordinate(request.resource.data, 'accuracyM', 1000000);
      allow delete: if isAdmin();
    }

    // AI settings (config/ai) are readable by signed-in salons so the app can show the switch.
    // The Claude API key never lives here: it is a Cloud Functions secret.
    // AI usage counters are written only by Cloud Functions (admin SDK).
    match /aiUsage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Private admin notes about a salon (never visible to the salon).
    match /adminNotes/{uid} {
      allow read, write: if isAdmin();
    }

    // Sequence counters for customer IDs and invoice numbers.
    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    // Subscription invoices. A salon may read its own invoices.
    match /invoices/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.accountUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Public "scan to verify" records behind invoice QR codes: random, unguessable ids,
    // minimal fields, and no listing.
    match /invoiceVerify/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // branding and app are public (the login screen shows support contacts); billing holds
    // bank details for invoices and is admin-only.
    match /config/{name} {
      allow get: if name in ['branding', 'app'] || (name in ['owner', 'ai'] && signedIn()) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
      // First admin claim (see /admins).
      allow create: if name == 'owner' && signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
